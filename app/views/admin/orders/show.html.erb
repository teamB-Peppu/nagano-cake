
            <h4>注文履歴詳細</h4>
            <%= form_with model: @order, url: admin_order_path(@order.id) do |f|%>
            <table>
                <tr>
                    <td class="font-weight-bold">購入者</td>
                    <td><%= link_to @order.name, admin_customer_path(@order.id) %></td>
                </tr>
                <tr>
                     <td class="font-weight-bold">注文日</td>
                     <td><%= @order.created_at %></td>
                </tr>
                <tr>
                    <td class="font-weight-bold">配送先</td>
                    <td><%= @order.postal_code %><%= @order.address %></td>
                </tr>
                <tr>
                    <td class="font-weight-bold">支払方法</td>
                    <td><%= @order.payment_method %></td>
                </tr>
                <tr>
                    <td class="font-weight-bold">注文ステータス</td>
                    <td><%= f.select :status, Order.statuses.keys %></td>
                    <td><%= f.submit '更新' %></td>
                </tr>
            </table>
            <% end %>
            <table>
                <thead>
                    <tr>
                        <th class="font-weight-bold">商品名</th>
                        <th class="font-weight-bold">単価（税込）</th>
                        <th class="font-weight-bold">数量</th>
                        <th class="font-weight-bold">小計</th>
                        <th class="font-weight-bold">製作ステータス</th>
                    </tr>
                </thead>
                <tbody>
                    <% @order_details.each do |order_detail| %>
                    <%= form_with model: order_detail, url: admin_order_detail_path, method: :patch do |f|%>
                    <%= f.hidden_field :order_detail_id, value: order_detail.id %>
                    <tr>
                        <td><%= order_detail.item.name %></td>
                        <td><%= order_detail.add_tax_sales_price.to_s(:dalimited) %></td>
                        <td><%= order_detail.amount %></td>
                        <td><%= order_detail.price %></td>
                        <td><%= f.select :making_status, OrderDetail.making_statuses.keys %></td>
                        <td><%= f.submit '更新' %></td>
                    </tr>
                    <% end %>
                <% end %>
                </tbody>
            </table>
            <table>
                <tr>
                    <td class="font-weight-bold">商品合計</td>
                    <td> <%= @order.sum_of_order_price %></td>
                </tr>
                <tr>
                    <td class="font-weight-bold">送料</td>
                    <td><%= @order.shipping_cost %></td>
                </tr>
                <tr>
                    <td class="font-weight-bold">請求金額合計</td>
                    <td><%= @order.total_payment %></td>
                </tr>
            </table>

<div class="container" style="max-width: 90%;">
    <div class="row">
      <div class="col-12">
        <h4 class="mt-3 bg-light text-center d-inline ml-5 px-3">注文履歴詳細</h4>
      </div>
    </div>
    <div class="row mt-4">
      <div class="col-lg-6 d-flex flex-column">
          <strong >注文情報</strong>
          <%= form_with model: @order, url: orders_path, method: :patch, local: true do |f| %>
            <table class="table table-hover table-bordered mt-2">
              <tr>
                <td class="bg-light">注文日</td>
                <td><%= @order.created_at %></td>
              </tr>
              <tr>
                <td class="bg-light">配送先</td>
                <td>
                  〒<%= @order.postal_code%>
                  <%= @order.address %>
                  <%= @order.name %>
                </td>
              </tr>
              <tr>
                <td class="bg-light">支払い方法</td>
                <td><%= @order.payment_method_i18n%></td>
              </tr>
              <tr>
                <td class="bg-light">ステータス</td>
                <td>
                  <%= @order.status_i18n %>
                </td>
              </tr>
            </table>
          <% end %>
            <strong>注文内容</strong>
            <table class="table table-hover table-bordered mt-2">
              <thead class="bg-light">
                <tr>
                  <th>商品</th>
                  <th>単価(税込)</th>
                  <th>個数</th>
                  <th>小計</th>
                </tr>
              </thead>
              <tbody>
                <% total_price = 0 %>
                <tr>
                <% @order.order_details.each do |order_detail| %>
                  <% sub_total = order_detail.amount * order_detail.item.price %>
                  <td><%= order_detail.item.name %></td>
                  <td><%= (order_detail.item.price * 1.1).floor %></td>
                  <td><%= order_detail.amount %></td>
                  <td><%= (order_detail.item.price * 1.1).floor * order_detail.amount %></td>
                  <% total_price +=  (order_detail.item.price * 1.1).floor * order_detail.amount %>
                </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <div class="col-lg-4">
          <strong>請求情報</strong>
            <table class="table table-hover table-bordered mt-2">
            <tr>
              <td class="bg-light">商品合計</td>
              <td><%= number_with_delimiter(total_price) %></td>
            </tr>
            <tr>
              <td class="bg-light">配送料</td>
              <td><%= number_with_delimiter(800) %></td>
            </tr>
            <tr>
              <td class="bg-light">ご請求額</td>
              <td><%= number_with_delimiter(total_price + 800) %></td>
            </tr>
          </table>
        </div>  
    </div>
  </div>  

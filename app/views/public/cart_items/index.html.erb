<div class="container">
  <div class="row justify-content-center">
    <div class="col-4 mt-5 text-left">
      <p>ショッピングカート</P>
    </div>
    <div class="col-5 mt-5 text-right">
      <%= link_to "カートを空にする", destroy_all_cart_items_path, class: "btn btn-sm btn-danger", method: :delete %>
    </div>
  </div>
  <div class="row justify-content-center">
    <div class="col-md-8 offset-md-1">
      <table class="table table-bordered border-2">
        <thead class="">
          <th>商品名</th>
          <th>単価（税込）</th>
          <th>数量</th>
          <th>小計</th>
          <th></th>
        </thead>
        <tbody class="">
          <% @cart_items.each do |cart_item| %>
          <tr>
            <td>
              <%= image_tag cart_item.item.get_image, width: 70, height: 40 %>
              <%= cart_item.item.name %>
            </td>
            <td><%= (cart_item.item.price * 1.1).floor %></td>
            <td>
            <%= form_with model: cart_item, url: cart_item_path(cart_item.id), local: true do |f| %>
                <%= f.select :amount, *[1..10] %>
                <%= f.submit "変更" , class: "btn btn-success" %>
              <% end %>
               </td>
              <td><%= cart_item.subtotal %></td>
              <td><%= link_to "削除する", cart_item_path(cart_item), class: "btn btn-sm btn-danger", method: :delete %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
  <div class="row justify-content-center ml-5">
    <div class="col-6 text-left ml-4">
      <%= link_to "買い物を続ける", root_path, class: "btn btn-primary" %>
    </div>
    <div class="col-2 ml-5 text-right">
      <table class="table table-bordered">
        <tr>
          <td class="text-left">合計金額</td>
          <td class="text-left"><%= @cart_items.sum(&:subtotal) %></td>
        </tr>
      </table>
    </div>
  </div>
  <div class="row justify-content-center">
    <% unless @cart_empty %>
    <%= link_to "情報入力に進む", new_order_path, class: "btn btn-success" %>
    <% end %>
  </div>
</div>
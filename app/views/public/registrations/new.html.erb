<div class="container">
  <div class="row">
    <div class="col">
      <h2 class="mt-3 bg-light d-inline px-3">新規会員登録</h2>
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <table class="table table-borderless table-sm mt-4" style="width:700px;">
        <tr>
          <td><%= f.label :name, "名前　　　　　　　　　(姓)" %></td>
          <td><%= f.text_field :last_name, autofocus: true, autocomplete: "last_name" %></td>
          <td>(名)　<%= f.text_field :first_name, autofocus: true, autocomplete: "first_name" %></td>
        </tr>
        <tr class="col-9">
          <td><%= f.label :name, "フリガナ　　　　　　　(セイ)" %></td>
          <td><%= f.text_field :last_name_kana, autofocus: true, autocomplete: "last_name_kana" %></td>
          <td>(メイ)<%= f.text_field :first_name_kana, autofocus: true, autocomplete: "first_name_kana" %></td>
        </tr>
        <tr>
          <td><%= f.label :email, "メールアドレス" %></td>
          <td><%= f.email_field :email, autofocus: true, autocomplete: "email" %></td>
        </tr>
        <tr>
          <td><%= f.label :postal_code, "郵便番号（ハイフンなし）" %></td>
          <td><%= f.text_field :postal_code, autofocus: true, autocomplete: "postal_code" %></td>
        </tr>
        <tr>
          <td><%= f.label :address, "住所" %></td>
          <td><%= f.text_field :address, autofocus: true, autocomplete: "address" %></td>
        </tr>
        <tr>
          <td><%= f.label :telephone_number,"電話番号（ハイフンなし）" %></td>
          <td><%= f.text_field :telephone_number, autofocus: true, autocomplete: "telephone_number" %></td>
        </tr>
        <tr>
          <td><%= f.label :password, "パスワード（６文字以上）" %></td>
          <% if @minimum_password_length %>
          <% end %>
          <td><%= f.password_field :password, autocomplete: "new-password" %></td>
        </tr>
        <tr>
          <td><%= f.label :password_confirmation, "パスワード（確認用）" %></td>
          <td><%= f.password_field :password_confirmation, autocomplete: "new-password" %></td>
        </tr>
        <tr>
          <td></td>
          <td><%= f.submit "　　　新規登録 　　　", class: "btn btn-success" %></td>
        </tr>
      </table>
      <% end %>
      
        <span class="bg-light"><strong>既に登録済みの方</strong></span>
        <p class="mt-3"><%= link_to "こちら　", new_session_path(resource_name) %>からログインしてください</p>

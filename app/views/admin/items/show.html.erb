<div class="container">
  <div class="row">
    <div class="col-mg-2">
      <h4 class="font-weight-bold my-4 bg-light">商品詳細</h4>
    </div>
  </div>
  <div class="row">

    <div class="col-lg-4">
      <%= image_tag @item.get_image, width: 300, height: 200 %>
    </div>

    <div class="col-lg-8">

      <table>
        <tr>
　　　    <td>商品名</td>
　　　    <td><%= @item.name %></td>
　　　  </tr>
　　　  <tr>
　　　    <td>商品説明</td>
　　　    <td><%= @item.introduction %></td>
　　　  </tr>
　　　  <tr>
　　　    <td>ジャンル</td>
　　　    <td><%= @item.genre.name %></td>
　　　  </tr>
　　　  <tr>
　　　    <td>税込価格(税抜価格)</td>
　　　    <td><%= (@item.price * 1.1).floor %> (<%= @item.price %>)円</td>
　　　  </tr>
　　　  <tr>
　　　    <td class="font-weight-bold">販売ステータス</td>
　　　    <td class="<%= @item.is_active? ? 'text-success font-weight-bold' : 'text-muted font-weight-bold' %> "><%= @item.status %></td>
　　　  </tr>
　　　</table>

　　</div>
  </div>
</div>

　　<div class="text-center">
　　  <%= link_to "編集する",edit_admin_item_path(@item.id),class: "btn btn-success" %>
　　</div>

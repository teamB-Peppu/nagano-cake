<!DOCTYPE html>
<html>
  <head>
    <title>NaganoCake</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    
    <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <header class="border-bottom">
      <nav class="navbar navbar-expand-lg">
        <div class="container">
          <a class="navbar-brand" href="/"><span>NaganoCake</span></a>
          <div class="navbar-header w-50">
            <ul class="nav navbar-nav d-flex justify-content-between w-100">
              <% if customer_signed_in? %>
                <li class="nav-item text-center"><%= link_to "マイページ",customers_path,class:" btn btn-outline-secondary text-dark nav-link" %></li>
                <li class="nav-item text-center"><%= link_to "商品一覧",items_path, class:" btn btn-outline-secondary text-dark nav-link" %></li>
                <li class="nav-item text-center"><%= link_to "カート",cart_items_path, class:"btn btn-outline-secondary text-dark ynav-link" %></li>
                <li class="nav-item text-center"><%= link_to "ログアウト",destroy_customer_session_path, method: :delete, class:"btn btn-outline-secondary text-dark nav-link" %></li>
              <% elsif admin_signed_in? %>
                <li class="nav-item flex-grow-1 text-center"><%= link_to "商品一覧",admin_items_path, class:"btn-outline-secondary text-dark nav-link"  %></li>
                <li><%= link_to "会員一覧",admin_customers_path, class:"btn-outline-secondary text-dark nav-link"  %></li>
                <li><%= link_to "注文履歴一覧",admin_admin_path, class:"btn-outline-secondary text-dark nav-link"  %></li>
                <li><%= link_to "ジャンル一覧",admin_genres_path, class:"btn-outline-secondary text-dark nav-link"  %></li>
                <li><%= link_to "ログアウト",destroy_admin_session_path, method: :delete, class:"btn-outline-secondary text-dark nav-link"  %></li>
              <% else %>
                <li><%= link_to "About",about_path, class:"btn btn-outline-secondary text-dark nav-link"  %></li>
                <li><%= link_to "商品一覧",items_path, class:"btn btn-outline-secondary text-dark nav-link"  %></li>
                <li><%= link_to "新規登録",new_customer_registration_path, class:"btn btn-outline-secondary text-dark nav-link"  %></li>
                <li><%= link_to "ログイン",new_customer_session_path, class:"btn btn-outline-secondary text-dark text-dark nav-link"  %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </nav>
    </header>  
    <main>
      <%= yield %>
    </main>
    <footer class="border-top">
      <div class='container mt-5' style="height: 100px">
      	<div class='row'>
        	<div class='mx-auto'>
        	</div>
        </div>
      </div>
    </footer>

  </body>
</html>

<div class="container">
    <div class="row justify-content-center">
        <div class="col">
           <h4 class=" mt-4 bg-light w-25 text-center">管理者ログイン</h4>
           <%= form_with model: @admin, url: session_path(resource_name), local: true do |f| %>
          <table class="mx-auto mt-5 w-75">
            <tr class="mx-auto">
              <td><%= f.label :email,"メールアドレス", class: "form-label" %></td>
              <td class="w-75 justify-content-end"><%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control " %></td>
            </tr>
            <tr class="mx-auto ">
              <td><%= f.label :password,"パスワード", class: "form-label mt-3" %></td>
              <td class="w-75 justify-content-end"><%= f.password_field :password, autocomplete: "current-password", class: "form-control " %></td>
            </tr>
            <tr class="mx-auto w-75">
              <td></td>
              <td><%= f.submit "ログイン", class: "btn btn-primary mt-4 w-25" %></td>
            </tr>
          </table>
          <% end %>
          <%= render "admin/shared/links" %>
      </div>
    </div>
</div>
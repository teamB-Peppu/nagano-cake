<div class="container">
  <div class="row">
    <div class="col-md-2">
      <h4 class="font-weight-bold my-4 bg-light">注文履歴詳細</h4>
    </div>
  </div>
  <div class="row">
    <div class="col">
      <%= form_with model: @order, url: admin_order_path(@order.id) do |f|%>
      <table>
        <tr>
          <td class="font-weight-bold">購入者</td>
          <td><%= link_to @order.name, admin_customer_path(@order.id) %></td>
        </tr>
        <tr>
          <td class="font-weight-bold">注文日</td>
          <td><%= @order.created_at %></td>
        </tr>
        <tr>
          <td class="font-weight-bold">配送先</td>
          <td>〒<%= @order.postal_code %><%= @order.address %><%= @order.name %></td>
        </tr>
        <tr>
          <td class="font-weight-bold">支払方法</td>
          <td><%= @order.payment_method_i18n %></td>
        </tr>
        <tr>
          <td class="font-weight-bold">注文ステータス</td>
          <td><%= f.select :status, Order.statuses.keys.map {|k| [I18n.t("enums.order.status.#{k}"), k]} %></td>
          <td><%= f.submit '更新',class: "btn btn-success" %></td>
        </tr>
      </table>
      <% end %>
    </div>
  </div>
  <div class="row">
    <div class="col-lg-8">
      <table>
        <thead>
          <tr class="bg-light">
            <th class="font-weight-bold">商品名</th>
            <th class="font-weight-bold">単価（税込）</th>
            <th class="font-weight-bold">数量</th>
            <th class="font-weight-bold">小計</th>
            <th class="font-weight-bold">製作ステータス</th>
          </tr>
        </thead>
        <tbody>
          <% total_price = 0 %>
          <% @order_details.each do |order_detail| %>
          <%= form_with model: order_detail, url: admin_order_detail_path, method: :patch do |f|%>
          <%= f.hidden_field :order_detail_id, value: order_detail.id %>
          <tr>
            <td><%= order_detail.item.name %></td>
            <td><%= (order_detail.item.price * 1.1).floor %></td>
            <td><%= order_detail.amount %></td>
            <td><%= (order_detail.item.price * 1.1).floor * order_detail.amount %></td>
            <td><%= f.select :making_status, OrderDetail.making_statuses.keys.map {|k| [I18n.t("enums.order_detail.making_status.#{k}"), k]} %></td>
            <td><%= f.submit '更新',class: "btn btn-success" %></td>
          </tr>
              <% total_price +=  (order_detail.item.price * 1.1).floor * order_detail.amount %>
          <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
    <div class="col-lg-4">
      <table>
        <tr>
          <td class="font-weight-bold">商品合計</td>
          <td> <%= total_price %>円</td>
        </tr>
        <tr>
          <td class="font-weight-bold">送料</td>
          <td><%= @order.shipping_cost %>円</td>
        </tr>
        <tr>
          <td class="font-weight-bold">請求金額合計</td>
          <td><%= total_price + @order.shipping_cost %>円</td>
        </tr>
      </table>

    </div>
  </div>
</div>

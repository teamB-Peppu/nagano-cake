<div class="container-fluid m-2">
  <p>配送先登録/一覧</p>

  <div class="form-group ml-5">
    <%= form_for(Address.new) do |f| %>
    <%= render "devise/shared/error_messages", resource: f.object %>

      <div class="form-group row">
        <div class="col-2 col-form-label">
          <%= f.label :postal_code, "郵便番号（ハイフンなし）" %>
        </div>
        <div class="col">
          <%= f.text_field :postal_code, autofocus: true, autocomplete: "postal_code" %>
        </div>
      </div>

      <div class="form-group row">
        <div class="col-2 col-form-label">
          <%= f.label :address, "住所" %>
        </div>
        <div class="col-5">
          <%= f.text_field :address, autofocus: true, autocomplete: "address" %>
        </div>
      </div>

      <div class="form-group row">
        <div class="col-2 col-form-label">
          <%= f.label :name, "宛名" %>
        </div>
        <div class="col">
          <%= f.text_field :name, autofocus: true, autocomplete: "name" %>
        </div>
        <div class="col">
          <%= f.submit "新規登録", class:"btn btn-success"%>
        </div>
      </div>
    <% end %>
  </div>

  <div class="col-8 ml-3">
    <table class="table table table-bordered m-2" id="custom-table">
      <thead class ="thead-light" id="custom-table">
        <tr>
          <th class="col-2">郵便番号</th>
          <th class="col-5">住所</th>
          <th class="col-2">宛名</th>
          <th class="col-3"></th>
        </tr>
      </thead>
      <tbody id="custom-table">
        <% @addresses.each do |address| %>
          <tr>
            <td><%= address.postal_code %></td>
            <td><%= address.address %></td>
            <td><%= address.name %></td>
            <td class="d-flex justify-content-center">
              <div class="mx-1">
                <%= link_to "編集する", edit_address_path(address), method: :get, class:"btn btn-success" %>
              </div>
              <div class="mx-1">
                <%= link_to "削除する", address_path(address), method: :delete, class:"btn btn-danger" %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
注文履歴詳細

注文情報

<%= form_with model: @order, url: orders_path, method: :patch, local: true do |f| %>
  <table>
    <tr>
      <td>注文日</td>
      <td><%= @order.created_at %></td>
    </tr>
    <tr>
      <td>配送先</td>
      <td>
        〒<%= @order.postal_code%>
        <%= @order.address %>
        <%= @order.name %>
      </td>
    </tr>
    <tr>
      <td>支払い方法</td>
      <td><%= @order.payment_method_i18n%></td>
    </tr>
    <tr>
      <td>ステータス</td>
      <td>
        <%= @order.status %>
      </td>
    </tr>
  </table>
<% end %>

注文内容

<table>
  <tr>
    <td>商品</td>
    <td>単価(税込)</td>
    <td>個数</td>
    <td>小計</td>
  </tr>
<table>
  <% total_price = 0 %>
  <% @order.order_details.each do |order_detail| %>
    <% sub_total = order_detail.amount * order_detail.item.price %>
    <tr>
      <td><%= order_detail.item.name %></td>
      <td><%= (order_detail.item.price * 1.1).floor %></td>
      <td><%= order_detail.amount %></td>
      <td><%= (order_detail.item.price * 1.1).floor * order_detail.amount %></td>
    </tr>
    <% total_price +=  (order_detail.item.price * 1.1).floor * order_detail.amount %>
  <% end %>
  <tr>
    <td>商品合計</td>
    <td></td>
    <td></td>
    <td><%= total_price %></td>
  </tr>
  <tr>
    <td>配送料</td>
    <td></td>
    <td></td>
    <td>800</td>
  </tr>
  <tr>
    <td>ご請求額</td>
    <td></td>
    <td></td>
    <td><%= total_price + 800 %></td>
  </tr>
</table>

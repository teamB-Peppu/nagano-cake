<div class="container-fluid m-2">
  <h4 class="bg-light d-inline-block p-2">会員情報編集</h4>

  <div class="form-group">
    <%= form_with model: @customer, url: customers_information_path, method: :patch do |f| %>

    <div class="form-group row ml-5">
      <div class="col-2 col-form-label">
        氏名
      </div>
      <div class="col">
        <%= f.text_field :last_name, autofocus: true, autocomplete: "last_name" %>
        <%= f.text_field :first_name, autofocus: true, autocomplete: "first_name" %>
      </div>
    </div>

    <div class="form-group row ml-5">
      <div class="col-2 col-form-label">
        <%= f.label :last_name_kana, "フリガナ" %>
      </div>
      <div class="col">
        <%= f.text_field :last_name_kana, autofocus: true, autocomplete: "last_name_kana" %>
        <%= f.text_field :first_name_kana, autofocus: true, autocomplete: "first_name_kana" %>
      </div>
    </div>

    <div class="form-group row ml-5">
      <div class="col-2">
        <%= f.label :postal_code, "郵便番号" %>
      </div>
      <div class="col-2">
        <%= f.text_field :postal_code, autofocus: true, autocomplete: "postal_code" %>
      </div>
    </div>

    <div class="form-group row ml-5">
      <div class="col-2">
        <%= f.label :address, "住所" %>
      </div>
      <div class="col-5">
        <%= f.text_field :address, autofocus: true, autocomplete: "address",style: "width: 100%" %>
      </div>
    </div>

    <div class="form-group row ml-5">
      <div class="col-2">
        <%= f.label :telephone_number,"電話番号（ハイフンなし）" %>
      </div>
      <div class="col">
        <%= f.text_field :telephone_number, autofocus: true, autocomplete: "telephone_number" %>
      </div>
    </div>

    <div class="form-group row ml-5">
      <div class="col-2">
        <%= f.label :email, "メールアドレス" %>
      </div>
      <div class="col">
        <%= f.email_field :email, autofocus: true, autocomplete: "email" %>
      </div>
    </div>

    <div class="form-group row ml-5">
      <div class="col-2">
      </div>
      <div class="col-2">
        <%= f.submit "変更内容を保存", class:"btn btn-success" %>
      </div>
      <div class="col">
        <%= link_to "退会する", customers_unsubscribe_path, class:"btn btn-danger" %>
      </div>
    </div>
    <% end %>
  </div>
</div>
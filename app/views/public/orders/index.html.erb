注文履歴一覧
<table>
  <tr>
    <td>注文日</td>
    <td>配送先</td>
    <td>注文商品</td>
    <td>支払金額</td>
    <td>ステータス</td>
    <td>注文詳細</td>
  </tr>
    <% @orders.each do |order| %>
      <tr>
          <td><%= order.created_at %></td>
          <td>
            <%= order.customer.postal_code %>
            <%= order.customer.address %>
            <%= order.customer.name %>
          </td>
          <td><%= order.item.name %></td>
          <td><%= @cart_items.sum(&:subtotal) + 800 %></td>
          <td><%= order.status %></td>
          <td><%= link_to "表示する", orders_id_ %></td>
      </tr>
    <% end %>
</table>
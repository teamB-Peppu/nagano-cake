<h4 class="font-weight-bold my-4">商品詳細</h4>

<div class="container">
  <div class="row">

    <div class="col-lg-4">
      <%= @item.image %>
    </div>

    <div class="col-lg-8">
　　　<div>商品名 <%= @item.name %></div>
　　　<div>商品説明 <%= @item.introduction %></div>
　　　<div>ジャンル <%= @item.genre.name %></div>
　　　<div>税込価格(税抜価格) <%= (@item.price * 1.1).floor %> (<%= @item.price %>)円</div>
　　　<div>販売ステータス <%= @item.is_active ? '販売中' : '販売停止中' %></div>

　　</div>
  </div>
</div>

　　<div class="text-center">
　　  <%= link_to "編集する",edit_admin_item_path(@item.id),class: "btn btn-success" %>
　　</div>

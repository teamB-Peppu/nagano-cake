<div class="container">
  <div class="row">
    <div class="col-mg-2">
      <h4 class="font-weight-bold my-4 bg-light">商品一覧</h4>
    </div>
    <div class="col-mg-8">
      <%= link_to new_admin_item_path do %>
        <i class="fa-solid fa-plus"></i>
      <% end %>
    </div>
  </div>

  <div class="row">
    <div class="col">

      <table class='table mx-auto my-5 w-75'>
        <thead>
          <tr class="bg-light">
            <th>商品ID</th>
            <th>商品名</th>
            <th>税抜価格</th>
            <th>ジャンル</th>
            <th>ステータス</th>
          </tr>
        </thead>

        <% @items.each do |item| %>

        <tbody>
          <tr>
            <td><%= item.id %></td>
            <td><%= link_to admin_item_path(item.id) do %>
                <%= item.name %>
                <% end %></td>
            <td><%= item.price %></td>
            <td><%= item.genre.name %></td>
            <td class="<%= item.is_active ? 'text-success font-weight-bold' : 'text-muted font-weight-bold' %>"><%= item.status %></td>
          </tr>
        </tbody>

        <% end %>

      </table>
      <%= paginate @items, class: "pagination" %>
    </div>
  </div>
</div>

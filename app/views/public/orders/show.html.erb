注文履歴詳細

注文情報

<%= form_with model: @order, url: orders_path, method: :patch, local: true do |f| %>
  <table>
    <tr>
      <td>注文日</td>
      <td><%= @order.created_at %></td>
    </tr>
    <tr>
      <td>配送先</td>
      <td><%= @order.postal_code%><%= @order.address %><%= @order.name %></td>
    </tr>
    <tr>
      <td>支払い方法</td>
      <td><%= @order.payment_method_i18n%></td>
    </tr>
    <tr>
      <td>ステータス</td>
      <td>
        <%= order.order_statuses_i18n.invert %>
      </td>
    </tr>
  </table>
<% end %>

注文内容

<table>
  <tr>
    <td>商品名</td>
    <td>単価(税込)</td>
    <td>個数</td>
    <td>小計</td>
  </tr>
<% @orders.each do |order| %>

<%= form_with model: order , url: orders_path(order.id) , method: :patch , local: true do |f| %>
    <table>
      <tr>
        <td><%= order.item.name %></td>
        <td><%= (order.item.price * 1.1).floor %></td>
        <td><%= order.item.amount %></td>
        <td><%= item.add_tax_sales_price %></td>
      </tr>
    </table>
    <table>
    <tr>
      <td>商品合計</td>
      <td><%= @orders.sum(&:subtotal) %></td>
    </tr>
    <tr>
      <td>配送料</td>
      <td>800</td>
    </tr>
    <tr>
      <td>ご請求額</td>
      <td><%= @orders.sum(&:subtotal) + 800 %></td>
    </tr>
  </table>
<% end %>
<!DOCTYPE html>
<html>
  <head>
    <title>NaganoCake</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <script src="https://kit.fontawesome.com/99e356431b.js" crossorigin="anonymous"></script>
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body class="d-flex flex-column vh-100 ">
    <header class="border-bottom">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-4 d-flex align-items-center">
                    <a class="navbar-brand" href="/" ><span>NaganoCake</span></a>
                </div>

                <div class="col-md-8">
                    <div class="d-flex flex-column align-items-end mt-3">
                        <nav class="navbar navbar-expand-lg p-0">
                            <ul class="nav">
                                <% if customer_signed_in? %>
                                    <li class="nav-item"><%= link_to "マイページ", customers_path, class: "nav-link btn btn-outline-secondary text-dark mx-3" %></li>
                                    <li class="nav-item"><%= link_to "商品一覧", items_path, class: "nav-link btn btn-outline-secondary text-dark mx-3" %></li>
                                    <li class="nav-item"><%= link_to "カート", cart_items_path, class: "nav-link btn btn-outline-secondary text-dark mx-3" %></li>
                                    <li class="nav-item"><%= link_to "ログアウト", destroy_customer_session_path, method: :delete, class: "nav-link btn btn-outline-secondary text-dark ml-3" %></li>
                                <% elsif admin_signed_in? %>
                                    <li class="nav-item"><%= link_to "商品一覧", admin_items_path, class: "nav-link btn btn-outline-secondary text-dark mx-3" %></li>
                                    <li class="nav-item"><%= link_to "会員一覧", admin_customers_path, class: "nav-link btn btn-outline-secondary text-dark mx-3" %></li>
                                    <li class="nav-item"><%= link_to "注文履歴一覧", admin_admin_path, class: "nav-link btn btn-outline-secondary text-dark mx-3" %></li>
                                    <li class="nav-item"><%= link_to "ジャンル一覧", admin_genres_path, class: "nav-link btn btn-outline-secondary text-dark mx-3" %></li>
                                    <li class="nav-item"><%= link_to "ログアウト", destroy_admin_session_path, method: :delete, class: "nav-link btn btn-outline-secondary text-dark ml-3" %></li>
                                <% else %>
                                    <li class="nav-item"><%= link_to "About", about_path, class: "nav-link btn btn-outline-secondary text-dark mx-3" %></li>
                                    <li class="nav-item"><%= link_to "商品一覧", items_path, class: "nav-link btn btn-outline-secondary text-dark mx-3" %></li>
                                    <li class="nav-item"><%= link_to "新規登録", new_customer_registration_path, class: "nav-link btn btn-outline-secondary text-dark mx-3" %></li>
                                    <li class="nav-item"><%= link_to "ログイン", new_customer_session_path, class: "nav-link btn btn-outline-secondary text-dark ml-3" %></li>
                                <% end %>
                            </ul>
                        </nav>

                        <form class="form-inline mt-2 mb-3">
                            <div class="input-group">
                                <input class="form-control" type="search" placeholder="Search" aria-label="Search">
                                <div class="input-group-append">
                                    <button class="btn btn-outline-secondary" type="submit">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </header>
    <main class="mb-3">
      <p class="mx-auto" id="notice"><%= notice %></p>
      <%= yield %>
    </main>
    <%= render 'layouts/footer' %>
  </body>
</html>

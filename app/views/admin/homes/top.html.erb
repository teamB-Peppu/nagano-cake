<div class="container">
  <div class="row">
    <div class="col-md-2">
      <h4 class="font-weight-bold my-4 bg-light">注文履歴一覧</h4>
    </div>
  </div>
  <div class="row">
    <div class="col">
      <table class='table mx-auto my-5 w-75'>
        <thead>
          <tr class="bg-light">
            <th class="font-weight-bold">購入日時</th>
            <th class="font-weight-bold">購入者</th>
            <th class="font-weight-bold">注文個数</th>
            <th class="font-weight-bold">注文ステータス</th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do|order| %>
          <% amount = 0 %>
          <% order.order_details.each do|order_detail| %>
          <% amount = amount + order_detail.amount %>
          <% end %>
          <tr>
            <td>
               <%= link_to order.created_at.strftime('%Y-%m-%d %H:%M'), admin_order_path(order), class: 'text-primary' %>
            </td>
            <td><%= order.name %></td>
            <td><%= amount %></td>
            <td><%= order.status_i18n %></td>
          </tr>
        </tbody>
        <% end %>
      </table>
      <%= paginate @orders, class: "pagination" %>
     </div>
    </div>
  </div>


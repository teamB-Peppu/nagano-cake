<table>
  <tr>
    <td>注文日</td>
    <td>配送先</td>
    <td>注文商品</td>
    <td>支払金額</td>
    <td>ステータス</td>
    <td>注文詳細</td>
  </tr>
  <% @orders.each do |order| %>
    <tr>
      <td><%= order.created_at %></td>
      <td>
        <%= order.postal_code %>
        <%= order.address %>
        <%= order.name %>
      </td>
      <% total_price = 0 %>
      <% order.order_details.each do |order_detail| %>
        <td>
          <%= order_detail.item.name %>
        </td>
         <% total_price +=  (order_detail.item.price * 1.1).floor * order_detail.amount %>
      <% end %>
      <td><%= total_price + 800 %></td>
      <td><%= order.status %></td>
      <td><%= link_to "表示する", order_path(order) %></td>
    </tr>
  <% end %>
</table>
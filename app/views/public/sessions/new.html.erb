<div class="container">
  <div class="row">
    <h5 class="mb-5 mt-5 px-4">ログイン</h5>
  </div>
  <div class="row ml-3 mb-4">
    <p class="text-center">会員の方はこちらからログイン</p>
  </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="row mx-auto">
      <div class="col-md-1"></div>
      <div class="col-md-3">
        <%= f.label :メールアドレス %>
      </div>
      <div class="col-md-8">
        <%= f.email_field :email, autofocus: true, autocomplete: "メールアドレス" %>
      </div>
    </div>

      <div class="row mx-auto">
        <div class="col-md-1"></div>
        <div class="col-md-3">
        <%= f.label :パスワード %>
        </div>
        <div class="col-md-8">
        <%= f.password_field :password, autocomplete: "パスワード" %>
        </div>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="row mx-auto">
        <div class="col-md-1"></div>
          <div class="col-md-8">
            <%= f.check_box :remember_me %>
            <%= f.label :remember_me %>
          </div>
        </div>
      <% end %>

      <div class="row col-md-2">
        <%= f.submit "ログイン",class: 'btn btn-sm btn-primary btn-block' %>
      </div>
    <% end %>

    <p class="row ml-3 mb-4">会員登録がお済出ない方</p>
    <p><a href="<%=%>">こちら</a>から新規登録を行ってください。</P>
  </div>
</div>

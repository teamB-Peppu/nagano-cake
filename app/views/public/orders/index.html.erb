<div class="container" style="max-width: 90%;">
    <div class="row ">
        <div class="col">
          <h4 class="mt-3 bg-light text-center d-inline ml-5 px-3">注文履歴一覧</h4>
          
          <table class='table table-bordered table-hover mx-auto my-3 w-100'>
            <thead class="bg-light">
              <tr>
                <th>注文日</th>
                <th>配送先</th>
                <th>注文商品</th>
                <th>支払金額</th>
                <th>ステータス</th>
                <th>注文詳細</th>
              </tr>
            </thead>
            <tbody>
              <% @orders.each do |order| %>
                <tr>
                  <td><%= order.created_at %></td>
                  <td style="width:600px;">
                    <%= order.postal_code %>
                    <%= order.address %>
                    <%= order.name %>
                  </td>
                  <% total_price = 0 %>
                  <% order.order_details.each do |order_detail| %>
                    <td>
                      <%= order_detail.item.name %>
                    </td>
                     <% total_price +=  (order_detail.item.price * 1.1).floor * order_detail.amount %>
                  <% end %>
                  <td><%= total_price + 800 %></td>
                  <td><%= order.status_i18n %></td>
                  <td><%= link_to "表示する", order_path(order),class: "btn btn-primary"%></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
    </div>
</div>        
                
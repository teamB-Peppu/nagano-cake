<div class="container">
  <div class="row mt-5">
    <div class="col-md-9">
      <h2>商品一覧（全<%= @items.count %>件）</h2>
      <div>
        <div class="row mt-3">
        <% @items.each do |item| %>
        <div class="col-md-3">
          <%= link_to item_path(item.id) do %>
            image
          <% end %>
          <%= item.name %>
          ¥<%= (item.price * 1.1).floor %>
        </div>
        <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
<!DOCTYPE html>
<html>
  <head>
    <title>NaganoCake</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
    <script src="https://kit.fontawesome.com/99e356431b.js" crossorigin="anonymous"></script>
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <header class="border-bottom">
      <nav class="navbar navbar-expand-lg">
        <div class="container">
          <a class="navbar-brand" href="/"><span>NaganoCake</span></a>
          <div class="navbar-header w-50">
            <ul class="nav navbar-nav d-flex justify-content-between w-100">
              <% if customer_signed_in? %>
                <li class="nav-item text-center"><%= link_to "マイページ",customers_path,class:" btn btn-outline-secondary text-dark nav-link" %></li>
                <li class="nav-item text-center"><%= link_to "商品一覧",items_path, class:" btn btn-outline-secondary text-dark nav-link" %></li>
                <li class="nav-item text-center"><%= link_to "カート",cart_items_path, class:"btn btn-outline-secondary text-dark ynav-link" %></li>
                <li class="nav-item text-center"><%= link_to "ログアウト",destroy_customer_session_path, method: :delete, class:"btn btn-outline-secondary text-dark nav-link" %></li>
              <% elsif admin_signed_in? %>
                <li class="nav-item text-center"><%= link_to "商品一覧",admin_items_path, class:"btn btn-outline-secondary text-dark nav-link"  %></li>
                <li class="nav-item text-center"><%= link_to "会員一覧",admin_customers_path, class:"btn btn-outline-secondary text-dark nav-link"  %></li>
                <li class="nav-item text-center"><%= link_to "注文履歴一覧",admin_admin_path, class:"btn btn-outline-secondary text-dark nav-link"  %></li>
                <li class="nav-item text-center"><%= link_to "ジャンル一覧",admin_genres_path, class:"btn btn-outline-secondary text-dark nav-link"  %></li>
                <li class="nav-item text-center"><%= link_to "ログアウト",destroy_admin_session_path, method: :delete, class:"btn btn-outline-secondary text-dark nav-link"  %></li>
              <% else %>
                <li class="nav-item text-center"><%= link_to "About",about_path, class:"btn btn-outline-secondary text-dark nav-link"  %></li>
                <li class="nav-item text-center"><%= link_to "商品一覧",items_path, class:"btn btn-outline-secondary text-dark nav-link"  %></li>
                <li class="nav-item text-center"><%= link_to "新規登録",new_customer_registration_path, class:"btn btn-outline-secondary text-dark nav-link"  %></li>
                <li class="nav-item text-center"><%= link_to "ログイン",new_customer_session_path, class:"btn btn-outline-secondary text-dark nav-link"  %></li>
              <% end %>
            </ul>
          </div>
        </div>
      </nav>
      <div class="container mt-2 mb-2">
        <form class="form-inline my-2 my-lg-0 justify-content-end ">
          <div class="input-group w-25">
            <input class="form-control" type="search" placeholder="Search" aria-label="Search">
            <div class="input-group-append">
              <button class="btn btn-outline-secondary" type="submit">
                <i class="bi bi-search"></i> <!-- Bootstrap Icons の検索アイコン -->
              </button>
            </div>
          </div>
        </form>
      </div>
    </header>
    <main>
      <p class="mx-auto" id="notice"><%= notice %></p>
      <%= yield %>
    </main>
    <footer class="border-top">
      <div class='container mt-5'>
      	<div class='row'>
        	<div class='mx-auto'>
        	</div>
        </div>
      </div>
    </footer>

  </body>
</html>
